# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# AI Providers (Options: "gemini", "openai", "mock")
# Set to "mock" for zero-credential offline testing and development
LLM_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mm_chatbot
DB_USER=root
DB_PASSWORD=root_password_here

# Database Fallback (set to True to use SQLite if MySQL is unavailable)
DB_USE_SQLITE_FALLBACK=True
SQLITE_DB_PATH=data/chatbot.db

# Storage & Paths
UPLOAD_DIR=data/uploads
VECTOR_DB_DIR=data/vector_db
KNOWLEDGE_BASE_DIR=data/knowledge_base

# Security & Upload Limits
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=png,jpg,jpeg,webp,mp3,wav,m4a,pdf,txt,docx

# Backend & Frontend Endpoints
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_API_URL=http://localhost:8000
